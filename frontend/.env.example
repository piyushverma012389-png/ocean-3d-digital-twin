# SIH26067 Indian Ocean Digital Twin — Environment Configuration Template
# Copy this file to .env or .env.local for local overrides.
# For GitHub Pages production builds, set VITE_API_BASE in GitHub Repository Secrets/Variables.

# Backend API Base URL
# - Local Development: http://127.0.0.1:8000/api (or /api via Vite proxy on port 5173)
# - Cloud Production: https://<your-backend-app>.onrender.com/api
VITE_API_BASE=http://127.0.0.1:8000/api
